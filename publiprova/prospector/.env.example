# ---- OpenAI ----------------------------------------------------------------
# Crie a chave em https://platform.openai.com/api-keys, num PROJETO SEPARADO,
# com permissao "Restricted", e defina hard limit mensal em Settings -> Limits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini
# O worker PARA sozinho ao atingir este teto no mes corrente.
OPENAI_MONTHLY_BUDGET_USD=25

# ---- Instagram (API oficial da Meta) ---------------------------------------
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---- Banco -----------------------------------------------------------------
DATABASE_URL=file:./data/prospector.db

# ---- Ritmo e limites -------------------------------------------------------
# Teto diario de respostas privadas a comentario. Saude da conta, nao evasao.
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo

# ---- Trava de seguranca ----------------------------------------------------
# true = nada e enviado de verdade; o sistema so registra o que faria.
# So mude para false depois do dry-run e com autorizacao explicita do operador.
DRY_RUN=true
