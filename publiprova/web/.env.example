SUPABASE_SERVICE_ROLE_KEY=

# ---- E-mail da régua de cobrança (Resend: 3.000/mês grátis) ----
# Sem a chave os e-mails viram log no console e o app continua funcionando.
RESEND_API_KEY=
MAIL_FROM="PubliProva <nao-responda@seudominio.com.br>"

# ---- Leitura do print por IA (opcional; sem a chave, digitação manual) ----
