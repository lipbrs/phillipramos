ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Cobrança automática ----
APP_URL=https://seuapp.com.br
CRON_SECRET=troque-por-um-valor-aleatorio-longo

# O login do painel é por link mágico enviado por e-mail — precisa do
